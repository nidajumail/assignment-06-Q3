class Book:
    total_books = 0  # Class variable

    def __init__(self, title):
        self.title = title
        Book.increment_book_count()  # Call class method to increase count

    @classmethod
    def increment_book_count(cls):
        cls.total_books += 1

    @classmethod
    def show_total_books(cls):
        print("Total books:", cls.total_books)


b1 = Book("Python Basics")
b2 = Book("Advanced Python")
b3 = Book("Data Science with Python")

Book.show_total_books()
