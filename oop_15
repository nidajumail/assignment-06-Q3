class A:
    def show(self):
        print("Method from class A")

class B(A):
    def show(self):
        print("Method from class B")

class C(A):
    def show(self):
        print("Method from class C")

class D(B, C):
    pass

# Create object of D
d = D()

# Call show() method
d.show()

# Print Method Resolution Order
print("MRO:", [cls.__name__ for cls in D.__mro__])
