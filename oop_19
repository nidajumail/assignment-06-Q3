class Multiplier:
    def __init__(self, factor):
        self.factor = factor

    def __call__(self, x):
        return x * self.factor

# Example usage
m = Multiplier(5)

# Check if object is callable
print(callable(m))  # Output: True

# Call the object like a function
result = m(10)  # 10 * 5 = 50
print(result)   # Output: 50
